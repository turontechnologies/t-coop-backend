# Temporary build-time override — the staged Java 21->25 upgrade
# (pom.xml/Dockerfile) isn't buildable yet: spring-boot-maven-plugin 3.3.5
# can't read Java 25 class files ("Unsupported class file major version
# 69"). This forces Java 21 bytecode for now without editing pom.xml or
# Dockerfile. Delete this file once the Spring Boot version is upgraded to
# one whose plugin supports Java 25.
-Djava.version=21
