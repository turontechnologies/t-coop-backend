# Copy this file to `.env` and fill in real values — never commit `.env`.
# These need to be set as actual environment variables before running the
# app (Spring Boot doesn't read .env files on its own; see README for how
# to export these in your shell or set them in your IDE run configuration).

# Azure SQL (or any MSSQL) connection details
DB_URL=jdbc:sqlserver://<your-server>.database.windows.net:1433;database=<your-db>;encrypt=true;trustServerCertificate=false;loginTimeout=30
DB_USERNAME=
DB_PASSWORD=

# Local server port (optional, defaults to 8080)
SERVER_PORT=8080

# Comma-separated list of frontend origins allowed to call this API.
# Include both local dev and the real deployed frontend.
FRONTEND_ORIGINS=http://localhost:3000,https://t-coop-app.vercel.app

# Cloudinary — server-side signed uploads (profile photos etc.)
# Moved here from the frontend's .env.local — get the real values from
# whoever holds the Cloudinary account, don't reuse old exposed keys as-is.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT signing secret — required, no default. Generate your own with
# `openssl rand -base64 32` (don't reuse this example value anywhere real).
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# --- Local development only (see docker-compose.yml) ---
# Point these at localhost instead of Azure while working offline / waiting
# for Azure access. Not used in staging/production.
LOCAL_DB_SA_PASSWORD=Local-Dev-Passw0rd!
